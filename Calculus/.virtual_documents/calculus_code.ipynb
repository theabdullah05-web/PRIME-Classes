import numpy as np
import matplotlib.pyplot as plt


x=np.linspace(1,100,100_000)
y=np.sqrt(x)

plt.plot(x,y, label="y = √x")
plt.grid(True)
plt .title("Calculus Functions Relationship")
plt.xlabel("Values")
plt.ylabel("Square Roots")
plt.legend()


x=np.linspace(-2*np.pi,2*np.pi,100)
y=np.sin(x)
plt.plot(x,y)



