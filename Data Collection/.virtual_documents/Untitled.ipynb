from bs4 import BeautifulSoup


with open("scraped_data/data.html","r") as f:
    html_content=f.read()
soup=BeautifulSoup(html_content,"lxml")


dt=soup.find_all("h3")
country_data=[]
for d in dt:
    name=d.get_text(strip=True)
    # print(d.find_parent("div")["class"])
    population=d.find_next("div").select_one("span.country-population").get_text(strip=True)
    country_data.append([name,population])
    print(d.parent())


df=pd.DataFrame(country_data,columns=["Name","Population"])


df.to_csv("data.csv",index=False)



