import requests
import pandas as pd


URL="https://api.imgflip.com/get_memes"
res=requests.get(URL)
data_json=res.json()


df=pd.json_normalize(data_json["data"]["memes"])
df=df[["id","name","url"]]


df.drop_duplicates()


df.isnull()


df.dropna()


